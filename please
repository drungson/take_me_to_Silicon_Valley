        *missing_packages
    ])

print("라이브러리 설치 확인 완료")


# ============================================================
# 1. 라이브러리 불러오기
# ============================================================

import os
import re
import csv
import json
import shutil
import zipfile
import traceback

from pathlib import Path

import gradio as gr
import torch
import librosa
import soundfile as sf

from datasets import Dataset, Audio

from transformers import (
    WhisperProcessor,
    WhisperForConditionalGeneration,
    Seq2SeqTrainingArguments,
    Seq2SeqTrainer
)


# ============================================================
# 2. 사용자 설정
# ============================================================

# AI-Hub API 키 입력
# 실제 키를 GitHub에 올리지 않도록 주의
AIHUB_API_KEY = os.getenv(
    "AIHUB_API_KEY",
    "여기에_API_KEY_입력"
)

DATASET_NAME = "구음장애 음성인식 데이터"

FILE_KEYS = {
    "train_audio": "32705",
    "train_label": "31785",
    "valid_audio": "65521",
    "valid_label": "65520"
}

DATA_DIR = Path("./data")
MODEL_DIR = Path("./model")

BASE_MODEL = "openai/whisper-small"

EPOCHS = 3
BATCH_SIZE = 2
LEARNING_RATE = 1e-5

MAX_AUDIO_SECONDS = 30

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"

DATA_DIR.mkdir(parents=True, exist_ok=True)
MODEL_DIR.mkdir(parents=True, exist_ok=True)


# ============================================================
# 3. AI-Hub Shell 설치
# ============================================================

def install_aihub():

    shell_path = DATA_DIR / "aihubshell"

    if shutil.which("aihubshell"):
        return "aihubshell"

    if shell_path.exists():
        return str(shell_path)

    print("AI-Hub Shell 다운로드 중...")

    try:
        subprocess.run(
            [
                "curl",
                "-fL",
                "https://api.aihub.or.kr/api/aihubshell.do",
                "-o",
                str(shell_path)
            ],
            check=True
        )

        shell_path.chmod(0o755)

        return str(shell_path)

    except Exception as e:
        raise RuntimeError(
            "AI-Hub Shell 설치 실패: " + str(e)
        )


# ============================================================
# 4. AI-Hub 데이터셋 키 확인
# ============================================================

def find_dataset_key(shell):

    result = subprocess.run(
        [
            shell,
            "-mode", "l",
            "-aihubapikey", AIHUB_API_KEY
        ],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace"
    )

    output = result.stdout + "\n" + result.stderr

    print(output)

    for line in output.splitlines():

        if DATASET_NAME in line:

            match = re.match(
                r"\s*(\d+)\s*,",
                line
            )

            if match:
                return match.group(1)

    raise RuntimeError(
        "데이터셋 키를 자동으로 찾지 못했습니다. "
        "AI-Hub 데이터셋 목록과 Shell 출력 형식을 확인하세요."
    )


# ============================================================
# 5. 데이터 다운로드
# ============================================================

def download_data():

    if (
        not AIHUB_API_KEY
        or "여기에_" in AIHUB_API_KEY
    ):
        raise ValueError(
            "AI-Hub API 키를 설정해야 합니다."
        )

    shell = install_aihub()

    dataset_key = find_dataset_key(shell)

    print("데이터셋 키:", dataset_key)

    for name, file_key in FILE_KEYS.items():

        print(name, "다운로드 시작")

        subprocess.run(
            [
                shell,
                "-mode", "d",
                "-datasetkey", dataset_key,
                "-filekey", file_key,
                "-aihubapikey", AIHUB_API_KEY
            ],
            cwd=str(DATA_DIR.resolve()),
            check=True
        )

    print("데이터 다운로드 완료")


# ============================================================
# 6. ZIP 압축 해제
# ============================================================

def extract_data():

    for zip_path in DATA_DIR.rglob("*.zip"):

        extract_path = (
            zip_path.parent / zip_path.stem
        )

        if extract_path.exists():
            continue

        print("압축 해제:", zip_path.name)

        with zipfile.ZipFile(zip_path) as z:
            z.extractall(extract_path)

    print("압축 해제 완료")


# ============================================================
# 7. JSON 데이터 분석
# ============================================================

AUDIO_KEYS = {
    "file_id",
    "filename",
    "audio_file",
    "audio",
    "wav",
    "source"
}

TEXT_KEYS = {
    "transcript",
    "text",
    "sentence",
    "script",
    "utterance",
    "발화문",
    "전사",
    "문장",
    "원문"
}


def normalize(key):

    return str(key).lower().replace("-", "_")


def extract_records(obj, inherited_audio=None):

    if isinstance(obj, list):

        for item in obj:

            yield from extract_records(
                item,
                inherited_audio
            )

    elif isinstance(obj, dict):

        audio = inherited_audio
        texts = []

        for key, value in obj.items():

            normalized = normalize(key)

            if not isinstance(value, str):
                continue

            if (
                normalized in AUDIO_KEYS
                or normalized.endswith("_file")
            ):

                if Path(value).suffix.lower() == ".wav":
                    audio = Path(value).name

            if (
                normalized in TEXT_KEYS
                and value.strip()
            ):
                texts.append(value.strip())

        if audio:

            for text in texts:

                yield {
                    "audio": audio,
                    "text": text
                }

        for value in obj.values():

            if isinstance(value, (dict, list)):

                yield from extract_records(
                    value,
                    audio
                )


# ============================================================
# 8. 학습 / 검증 데이터 분류
# ============================================================

def identify_split(path):

    path = str(path).lower()

    if (
        "vl01" in path
        or "validation" in path
    ):
        return "validation"

    if (
        "tl01" in path
        or "training" in path
    ):
        return "train"

    return None


# ============================================================
# 9. WAV와 JSON 연결
# ============================================================

def prepare_data():

    print("WAV 파일 검색 중...")

    audio_files = {}

    for wav in DATA_DIR.rglob("*.wav"):

        audio_files.setdefault(
            wav.name.lower(),
            []
        ).append(wav)

    train_rows = []
    valid_rows = []

    for json_file in DATA_DIR.rglob("*.json"):

        split = identify_split(json_file)

        if split is None:
            continue

        try:

            with open(
                json_file,
                encoding="utf-8-sig"
            ) as f:

                data = json.load(f)

        except Exception as e:

            print("JSON 오류:", e)
            continue

        for record in extract_records(data):

            filename = record["audio"].lower()

            matches = audio_files.get(
                filename,
                []
            )

            matched_audio = None

            for candidate in matches:

                if identify_split(candidate) == split:
                    matched_audio = candidate
                    break

            if (
                matched_audio is None
                and len(matches) == 1
            ):
                matched_audio = matches[0]

            if matched_audio is None:
                continue

            row = {
                "audio": str(matched_audio.resolve()),
                "text": record["text"]
            }

            if split == "train":
                train_rows.append(row)

            else:
                valid_rows.append(row)

    def unique_rows(rows):

        result = {}

        for row in rows:

            key = (
                row["audio"],
                row["text"]
            )

            result[key] = row

        return list(result.values())

    train_rows = unique_rows(train_rows)
    valid_rows = unique_rows(valid_rows)

    def save_csv(rows, filename):

        output = DATA_DIR / filename

        with open(
            output,
            "w",
            newline="",
            encoding="utf-8-sig"
        ) as f:

            writer = csv.DictWriter(
                f,
                fieldnames=["audio", "text"]
            )

            writer.writeheader()
            writer.writerows(rows)

    save_csv(
        train_rows,
        "train_manifest.csv"
    )

    save_csv(
        valid_rows,
        "validation_manifest.csv"
    )

    print("학습 데이터:", len(train_rows))
    print("검증 데이터:", len(valid_rows))

    return train_rows, valid_rows


# ============================================================
# 10. 학습 데이터 전처리
# ============================================================

def load_audio_records(rows):

    result = []

    for row in rows:

        try:

            info = sf.info(row["audio"])

            if (
                info.duration <= MAX_AUDIO_SECONDS
                and row["text"].strip()
            ):

                result.append({
                    "audio": row["audio"],
                    "sentence": row["text"]
                })

        except Exception as e:

            print("파일 제외:", e)

    return result


# ============================================================
# 11. Whisper 모델 학습
# ============================================================

def train_model(train_rows, valid_rows):

    print("모델 학습 준비 중...")

    train_rows = load_audio_records(train_rows)
    valid_rows = load_audio_records(valid_rows)

    print("실제 학습 데이터:", len(train_rows))
    print("실제 검증 데이터:", len(valid_rows))

    if not train_rows or not valid_rows:

        raise ValueError(
            "학습 또는 검증 데이터가 부족합니다. "
            "JSON과 WAV 연결 결과를 확인하세요."
        )

    processor = WhisperProcessor.from_pretrained(
        BASE_MODEL,
        language="Korean",
        task="transcribe"
    )

    model = WhisperForConditionalGeneration.from_pretrained(
        BASE_MODEL
    )

    model.generation_config.language = "korean"
    model.generation_config.task = "transcribe"

    train_ds = Dataset.from_list(train_rows)
    valid_ds = Dataset.from_list(valid_rows)

    train_ds = train_ds.cast_column(
        "audio",
        Audio(sampling_rate=16000)
    )

    valid_ds = valid_ds.cast_column(
        "audio",
        Audio(sampling_rate=16000)
    )

    def preprocess(batch):

        audio = batch["audio"]

        features = processor.feature_extractor(
            audio["array"],
            sampling_rate=audio["sampling_rate"]
        )

        batch["input_features"] = (
            features.input_features[0]
        )

        batch["labels"] = processor.tokenizer(
            batch["sentence"]
        ).input_ids

        return batch

    train_ds = train_ds.map(
        preprocess,
        remove_columns=train_ds.column_names
    )

    valid_ds = valid_ds.map(
        preprocess,
        remove_columns=valid_ds.column_names
    )

    def collate(features):

        input_features = torch.tensor([
            item["input_features"]
            for item in features
        ])

        labels = processor.tokenizer.pad(
            {
                "input_ids": [
                    item["labels"]
                    for item in features
                ]
            },
            return_tensors="pt"
        )

        labels["input_ids"][
            labels["attention_mask"] == 0
        ] = -100

        return {
            "input_features": input_features,
            "labels": labels["input_ids"]
        }

    training_args = Seq2SeqTrainingArguments(

        output_dir=str(MODEL_DIR),

        per_device_train_batch_size=BATCH_SIZE,
        per_device_eval_batch_size=BATCH_SIZE,

        learning_rate=LEARNING_RATE,
        num_train_epochs=EPOCHS,

        eval_strategy="epoch",
        save_strategy="epoch",

        predict_with_generate=True,

        fp16=torch.cuda.is_available(),

        logging_steps=25,

        report_to="none"
    )

    trainer = Seq2SeqTrainer(

        model=model,
        args=training_args,

        train_dataset=train_ds,
        eval_dataset=valid_ds,

        data_collator=collate,

        processing_class=processor
    )

    print("모델 학습 시작")

    trainer.train()

    trainer.save_model(str(MODEL_DIR))
    processor.save_pretrained(str(MODEL_DIR))

    print("모델 학습 완료")


# ============================================================
# 12. 학습 모델 불러오기
# ============================================================

processor = None
model = None


def load_model():

    global processor, model

    if model is not None:
        return

    if not (MODEL_DIR / "config.json").exists():

        raise RuntimeError(
            "학습 모델이 없습니다. 먼저 모델 학습을 진행하세요."
        )

    processor = WhisperProcessor.from_pretrained(
        str(MODEL_DIR)
    )

    model = WhisperForConditionalGeneration.from_pretrained(
        str(MODEL_DIR)
    )

    model.to(DEVICE)
    model.eval()


# ============================================================
# 13. 음성 인식
# ============================================================

def recognize(audio_path):

    if audio_path is None:

        return (
            "음성을 입력해 주세요.",
            gr.update(choices=[], value=None),
            ""
        )

    try:

        load_model()

        audio, sr = librosa.load(
            audio_path,
            sr=16000,
            mono=True
        )

        audio = audio[:30 * 16000]

        inputs = processor(
            audio,
            sampling_rate=16000,
            return_tensors="pt"
        )

        inputs = {
            key: value.to(DEVICE)
            for key, value in inputs.items()
        }

        with torch.no_grad():

            outputs = model.generate(
                inputs["input_features"],
                num_beams=3,
                num_return_sequences=3,
                max_new_tokens=128
            )

        predictions = processor.batch_decode(
            outputs,
            skip_special_tokens=True
        )

        candidates = list(dict.fromkeys(
            text.strip()
            for text in predictions
            if text.strip()
        ))

        if not candidates:

            return (
                "음성을 인식하지 못했습니다.",
                gr.update(choices=[], value=None),
                ""
            )

        return (
            candidates[0],
            gr.update(
                choices=candidates,
                value=candidates[0]
            ),
            candidates[0]
        )

    except Exception as e:

        traceback.print_exc()

        return (
            f"오류가 발생했습니다: {e}",
            gr.update(choices=[], value=None),
            ""
        )


# ============================================================
# 14. 후보 문장 선택
# ============================================================

def select_candidate(choice):

    return choice or ""


# ============================================================
# 15. 데이터 다운로드 및 모델 학습
# ============================================================

def run_training():

    try:

        print("===== 데이터 다운로드 =====")

        download_data()

        print("===== 압축 해제 =====")

        extract_data()

        print("===== 데이터 정리 =====")

        train_rows, valid_rows = prepare_data()

        print("===== 모델 학습 =====")

        train_model(
            train_rows,
            valid_rows
        )

        global model, processor

        model = None
        processor = None

        return (
            "데이터 준비와 모델 학습이 완료되었습니다."
        )

    except Exception as e:

        traceback.print_exc()

        return f"학습 실패: {e}"


