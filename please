# 0. 필요한 라이브러리 자동 설치
import sys
import subprocess
import importlib.util

REQUIRED_PACKAGES = {
    "gradio": "gradio",
    "torch": "torch",
    "librosa": "librosa",
    "soundfile": "soundfile",
    "datasets": "datasets",
    "transformers": "transformers",
    "accelerate": "accelerate"
}

